# 复制为 .env 使用(.env 已被 gitignore)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 使用本机 DEEPSEEK_API_KEY 环境变量，或取消下一行注释填入密钥；LLM_API_KEY 优先。
# LLM_API_KEY=your-deepseek-api-key
LLM_VLLM_CHAT_TEMPLATE=false
# 如需切回 vLLM：修改 LLM_BASE_URL / LLM_MODEL / LLM_API_KEY，并将上面的开关设为 true。
# 前端来源(CORS,逗号分隔;Next.js dev 默认 3000 端口两种写法)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
