   "sql": "SELECT strftime('%Y-%m', o.order_date) AS ym,\n       COUNT(DISTINCT o.order_id) AS orders,\n       COUNT(*) AS items,\n       ROUND(SUM(oi.sales), 2) AS sales,\n       ROUND(SUM(oi.profit), 2) AS profit,\n       ROUND(SUM(oi.profit) / NULLIF(SUM(oi.sales), 0) * 100, 2) AS margin_pct\nFROM orders o\nJOIN order_items oi ON oi.order_id = o.order_id\nWHERE o.order_date >= '2014-01-01' AND o.order_date < '2015-01-01'\nGROUP BY ym\nORDER BY ym",
